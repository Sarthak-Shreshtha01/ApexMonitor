{
  "name": "@apexmonitor/sdk",
  "version": "0.1.0",
  "description": "Official ApexMonitor TypeScript SDK",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/pulseapi.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "apexmonitor",
    "observability",
    "sdk"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^6.0.2"
  }
}
