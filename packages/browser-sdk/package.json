{
  "name": "@apexmonitor/browser-sdk",
  "version": "0.1.0",
  "description": "Browser SDK for ApexMonitor RUM and frontend telemetry",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "apexmonitor",
    "rum",
    "browser",
    "sdk"
  ],
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@apexmonitor/sdk": "0.1.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^6.0.2"
  }
}
