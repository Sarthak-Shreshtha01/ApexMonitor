# Copy to `.env` at the repository root. Read by apps/server/src/config/config.ts.
# Generate secrets with: openssl rand -base64 48
# See docs/reference/configuration.md for every variable.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Datastores (match docker-compose.yml)
MONGO_URI=mongodb://localhost:27018/apexmonitor
PG_URI=postgresql://pulse:pulse_dev_password@localhost:9999/apexmonitor
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://pulse:pulse_dev@localhost:5672

# Security (each at least 32 characters)
JWT_SECRET=replace-with-at-least-32-random-characters
ARGON2_PEPPER=replace-with-at-least-32-random-characters
# Optional dedicated refresh-token key (derived from JWT_SECRET when unset)
# JWT_REFRESH_SECRET=

# URLs
CORS_ORIGINS=http://localhost:3001
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Rate limits
RATE_LIMIT_RPM=60000
# RUM_RATE_LIMIT_RPM=120000

# OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/github/callback

# Payments (optional). Billing is off unless merchant id AND salt key are set.
# PhonePe's public sandbox values for local testing (refused when NODE_ENV=production):
# PHONEPE_ENV=sandbox
# PHONEPE_MERCHANT_ID=PGTESTPAYUAT
# PHONEPE_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
# PHONEPE_SALT_INDEX=1
