{
  "name": "apexmonitor",
  "private": true,
  "version": "1.0.0",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:sdk": "npm run build --workspace=@apexmonitor/sdk",
    "build:browser-sdk": "npm run build --workspace=@apexmonitor/browser-sdk",
    "build:sdks": "npm run build:sdk && npm run build:browser-sdk",
    "conformance:sdks": "node scripts/sdk-conformance.mjs",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "check:release-version": "node scripts/check-release-version.mjs",
    "test": "npm run test --workspaces --if-present && npm run test:python-sdk",
    "test:integration": "npm run test:integration --workspace=apps/server",
    "test:python-sdk": "cd packages/python-sdk && python3 -m unittest discover -s tests",
    "test:all": "npm test && npm run test:integration",
    "db:migrate": "npm run db:migrate --workspace=apps/server",
    "db:migrate:status": "npm run db:migrate --workspace=apps/server -- status"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.14.0",
    "zustand": "^5.0.12"
  }
}
