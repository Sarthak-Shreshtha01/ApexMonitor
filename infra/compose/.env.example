# Copy to infra/compose/.env and fill in. Never commit the filled-in file.
# Generate each secret with:  openssl rand -hex 32
# Use URL-safe values (hex is fine): passwords are embedded in connection URLs.

# Public URLs (what browsers use; put TLS in front of both)
API_BASE_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# Application secrets (at least 32 characters)
JWT_SECRET=
JWT_REFRESH_SECRET=
ARGON2_PEPPER=

# Datastores
POSTGRES_USER=apexmonitor
POSTGRES_PASSWORD=
POSTGRES_DB=apexmonitor
MONGO_USER=apexmonitor
MONGO_PASSWORD=
REDIS_PASSWORD=
REDIS_MAXMEMORY=512mb
RABBITMQ_USER=apexmonitor
RABBITMQ_PASSWORD=

# Session cookie. app.example.com and api.example.com are the same site, so lax works.
# Set COOKIE_DOMAIN=.example.com to share the refresh cookie with the dashboard; then
# WEB_SESSION_COOKIE_CHECK=true lets the dashboard redirect signed-out visitors on the server.
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
WEB_SESSION_COOKIE_CHECK=false

# Published ports
API_PORT=3000
WEB_PORT=3001
